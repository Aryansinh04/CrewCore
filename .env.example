# Crewcore Environment Variables Template
# Copy this file to .env and fill in the values

# Port for the Express server to listen on
PORT=5000

# MongoDB Connection URI (e.g., mongodb://localhost:27017/crewcore_db)
MONGODB_URI=

# JWT Secret key for authentication signing
JWT_SECRET=

# Nodemailer SMTP Configuration for sending email invites
SMTP_USER=
SMTP_PASS=

# Google Gemini Generative AI API Key for real-time summaries, screening, and chat
GEMINI_API_KEY=
